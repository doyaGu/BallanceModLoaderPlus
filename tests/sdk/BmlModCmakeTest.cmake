if(NOT DEFINED BML_MOD_CMAKE OR "${BML_MOD_CMAKE}" STREQUAL "")
    message(FATAL_ERROR "BmlModCmakeTest needs BML_MOD_CMAKE.")
endif()
if(NOT DEFINED TEST_CASE OR "${TEST_CASE}" STREQUAL "")
    message(FATAL_ERROR "BmlModCmakeTest needs TEST_CASE.")
endif()

if(TEST_CASE MATCHES "^(compiler|runtime|runtime-policy)$")
    # A core C ABI Mod may use another C++ compiler/runtime locally. Only an
    # explicitly linked C++ extension imposes the matching SDK restriction.
    set(root "${CMAKE_CURRENT_BINARY_DIR}/bml-extension-${TEST_CASE}")
    file(MAKE_DIRECTORY "${root}/source")
    file(WRITE "${root}/source/mod.cpp" "int fixture;\n")
    set(project [=[
cmake_minimum_required(VERSION 3.25)
project(ExtensionFixture LANGUAGES CXX)
add_library(BML::BML INTERFACE IMPORTED)
add_library(BML::ImGui INTERFACE IMPORTED)
set(BML_SDK_POINTER_SIZE "${CMAKE_SIZEOF_VOID_P}")
set(BML_SDK_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}")
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" BML_TARGET_ARCH)
if(BML_TARGET_ARCH MATCHES "^(aarch64|arm64)$")
    set(BML_TARGET_ARCH arm64)
elseif(BML_TARGET_ARCH MATCHES "^(amd64|x86_64|x64)$")
    set(BML_TARGET_ARCH x64)
endif()
set(BML_ABI_JSON "{}")
set_property(TARGET BML::BML PROPERTY BML_SDK_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}")
set_property(TARGET BML::BML PROPERTY BML_SDK_COMPILER_VERSION "${CMAKE_CXX_COMPILER_VERSION}")
if("@TEST_CASE@" STREQUAL "compiler")
    set_property(TARGET BML::BML PROPERTY BML_SDK_COMPILER_VERSION "0.0.0")
else()
    set_property(TARGET BML::BML PROPERTY BML_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
    if("@TEST_CASE@" STREQUAL "runtime")
        set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDebugDLL)
    else()
        cmake_policy(SET CMP0091 OLD)
    endif()
endif()
include("@BML_MOD_CMAKE@")
bml_add_mod(Fixture mod.cpp)
if(EXTENSION)
    add_library(Intermediate INTERFACE)
    target_link_libraries(Intermediate INTERFACE BML::ImGui)
    target_link_libraries(Fixture PRIVATE Intermediate)
endif()
cmake_language(DEFER CALL _bml_resolve_sdk_extensions)
]=])
    string(CONFIGURE "${project}" project @ONLY)
    file(WRITE "${root}/source/CMakeLists.txt" "${project}")
    foreach(extension OFF ON)
        execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source"
                -B "${root}/${extension}" -DEXTENSION=${extension}
                RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(extension STREQUAL "OFF")
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Core C ABI Mod was rejected: ${output}\n${error}")
            endif()
        else()
            if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "(requires .*0.0.0|requires MSVC runtime|need policy CMP0091)")
                message(FATAL_ERROR "Extension ABI check did not reject ${TEST_CASE}: ${output}\n${error}")
            endif()
        endif()
    endforeach()
    message(STATUS "Core C ABI and optional C++ extension checks passed")
    return()
endif()

set(BML_RUNTIME sdl)
set(CMAKE_CXX_COMPILER_ID Clang)
set(CMAKE_CXX_COMPILER_VERSION 20.1.0)
set(BML_SDK_COMPILER_ID Clang)
set(BML_SDK_COMPILER_VERSION 20.1.0)
set(CMAKE_SIZEOF_VOID_P 8)
set(BML_SDK_POINTER_SIZE 8)
set(CMAKE_SYSTEM_NAME Linux)
set(BML_SDK_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(BML_TARGET_ARCH x64)
if(TEST_CASE STREQUAL "compiler")
    set(CMAKE_CXX_COMPILER_VERSION 19.0.0)
elseif(TEST_CASE STREQUAL "architecture")
    set(BML_SDK_POINTER_SIZE 4)
elseif(TEST_CASE STREQUAL "runtime")
    set(BML_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDebugDLL")
    cmake_policy(SET CMP0091 NEW)
elseif(TEST_CASE STREQUAL "runtime-policy")
    set(BML_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
    cmake_policy(SET CMP0091 OLD)
elseif(TEST_CASE STREQUAL "sdl-architecture")
    set(BML_TARGET_ARCH arm64)
else()
    message(FATAL_ERROR "Unknown BmlModCmakeTest case: ${TEST_CASE}")
endif()

include("${BML_MOD_CMAKE}")
bml_add_mod(InvalidMod "${CMAKE_CURRENT_LIST_FILE}")
message(FATAL_ERROR "bml_add_mod accepted the invalid ${TEST_CASE} case.")
