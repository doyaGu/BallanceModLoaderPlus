api bml.events 1.0

schema event = 1 {
    int kind = 1
    optional string filename = 2
    optional bool is_map = 3
    optional string master_name = 4
    optional int filter_class = 5
    optional bool add_to_scene = 6
    optional bool reuse_meshes = 7
    optional bool reuse_materials = 8
    optional bool dynamic = 9
    optional array<object> object_ids = 10
    optional object master_object = 11
    optional object script = 12
    optional object target = 13
    optional bool fixed = 14
    optional float friction = 15
    optional float elasticity = 16
    optional float mass = 17
    optional string collision_group = 18
    optional bool start_frozen = 19
    optional bool enable_collision = 20
    optional bool auto_calculate_mass_center = 21
    optional float linear_damp = 22
    optional float rot_damp = 23
    optional string collision_surface = 24
    optional vec3 mass_center = 25
    optional array<object> convex_meshes = 26
    optional array<vec3> ball_centers = 27
    optional array<float> ball_radii = 28
    optional array<object> concave_meshes = 29
    optional string command = 30
    optional array<string> command_args = 31
    optional string config_category = 32
    optional string config_key = 33
    optional int config_type = 34
    optional string config_value = 35
    optional bool cheat_enabled = 36
}

topic all(event)
