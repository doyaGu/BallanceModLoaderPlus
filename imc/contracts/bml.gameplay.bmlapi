api bml.gameplay 1.0

schema level_state = 1 {
    int id = 1
    object active_ball = 2
    mat4 reset_matrix = 3
    int points = 4
}

schema energy_state = 2 {
    int points = 1
    int lives = 2
    int start_points = 3
    int start_lives = 4
    float time_factor = 5
    int life_bonus = 6
}

schema catalog_response = 3 {
    array<string> files = 1
    array<string> start_balls = 2
    array<string> skies = 3
    array<int> bonuses = 4
    array<int> music = 5
}

schema checkpoints_response = 4 {
    array<mat4> matrices = 1
    array<object> objects = 2
}

schema resetpoints_response = 5 {
    array<object> objects = 1
}

rpc catalog() -> catalog_response
rpc checkpoints() -> checkpoints_response
rpc energy() -> energy_state
rpc level() -> level_state
rpc resetpoints() -> resetpoints_response
