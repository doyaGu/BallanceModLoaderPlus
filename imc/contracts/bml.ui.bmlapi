api bml.ui 1.0

schema message_input = 1 {
    string message = 1
}

schema hud_mode_input = 2 {
    int mode = 1
}

schema visible_input = 3 {
    bool visible = 1
}

schema hud_state = 4 {
    int mode = 1
    float sr_time = 2
}

rpc hud_fps_show(visible_input)
rpc hud_set(hud_mode_input)
rpc hud_sr_pause()
rpc hud_sr_reset()
rpc hud_sr_show(visible_input)
rpc hud_sr_start()
rpc hud_title_show(visible_input)
rpc map_menu_close()
rpc map_menu_open()
rpc message_add(message_input)
rpc message_clear()
rpc mods_menu_close()
rpc mods_menu_open()
rpc state() -> hud_state
