api bml.scene 1.0

schema object_info = 1 {
    int id = 1
    string name = 2
    int class_id = 3
    bool visible = 4
    bool dynamic = 5
}

schema entity_transform = 2 {
    vec3 position = 1
    vec3 scale = 2
    object parent = 3
    int child_count = 4
}

schema find_name_request = 3 {
    string name = 1
}

schema find_name_class_request = 4 {
    string name = 1
    int class_id = 2
}

schema find_result = 5 {
    object object = 1
}

schema object_request = 6 {
    object object = 1
}

rpc entity(object_request) -> entity_transform
rpc find_name(find_name_request) -> find_result
rpc find_name_class(find_name_class_request) -> find_result
rpc object(object_request) -> object_info
