{
  "api": "bml.scene",
  "version": {
    "major": 1,
    "minor": 0
  },
  "schemas": [
    {
      "id": 1,
      "name": "object_info",
      "fields": [
        { "id": 1, "name": "id", "type": "int" },
        { "id": 2, "name": "name", "type": "string" },
        { "id": 3, "name": "class_id", "type": "int" },
        { "id": 4, "name": "visible", "type": "bool" },
        { "id": 5, "name": "dynamic", "type": "bool" }
      ]
    },
    {
      "id": 2,
      "name": "entity_transform",
      "fields": [
        { "id": 1, "name": "position", "type": "vec3" },
        { "id": 2, "name": "scale", "type": "vec3" },
        { "id": 3, "name": "parent", "type": "object" },
        { "id": 4, "name": "child_count", "type": "int" }
      ]
    },
    {
      "id": 3,
      "name": "find_name_request",
      "fields": [
        { "id": 1, "name": "name", "type": "string" }
      ]
    },
    {
      "id": 4,
      "name": "find_name_class_request",
      "fields": [
        { "id": 1, "name": "name", "type": "string" },
        { "id": 2, "name": "class_id", "type": "int" }
      ]
    },
    {
      "id": 5,
      "name": "find_result",
      "fields": [
        { "id": 1, "name": "object", "type": "object" }
      ]
    }
  ],
  "endpoints": [
    { "name": "entity", "kind": "component", "output": 2 },
    { "name": "find_name", "kind": "query", "input": 3, "output": 5 },
    { "name": "find_name_class", "kind": "query", "input": 4, "output": 5 },
    { "name": "object", "kind": "component", "output": 1 }
  ]
}
