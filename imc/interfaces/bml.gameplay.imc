api bml.gameplay 1.0

record level_state {
    int id
    object active_ball
    mat4 reset_matrix
    int points
}

record energy_state {
    int points
    int lives
    int start_points
    int start_lives
    float time_factor
    int life_bonus
}

record catalog_response {
    array<string> files
    array<string> start_balls
    array<string> skies
    array<int> bonuses
    array<int> music
}

record checkpoints_response {
    array<mat4> matrices
    array<object> objects
}

record resetpoints_response {
    array<object> objects
}

rpc catalog() -> catalog_response
rpc checkpoints() -> checkpoints_response
rpc energy() -> energy_state
rpc level() -> level_state
rpc resetpoints() -> resetpoints_response
