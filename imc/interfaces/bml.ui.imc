api bml.ui 2.0

record message_input {
    string message
}

record hud_mode_input {
    int mode
}

record visible_input {
    bool visible
}

record hud_state {
    int mode
}

rpc hud_fps_show(visible_input)
rpc hud_set(hud_mode_input)
rpc hud_title_show(visible_input)
rpc map_menu_close()
rpc map_menu_open()
rpc message_add(message_input)
rpc message_clear()
rpc mods_menu_close()
rpc mods_menu_open()
rpc state() -> hud_state
