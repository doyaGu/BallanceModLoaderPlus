api bml.scene 1.0

record object_info {
    int id
    string name
    int class_id
    bool visible
    bool dynamic
}

record entity_transform {
    vec3 position
    vec3 scale
    object parent
    int child_count
}

record find_name_request {
    string name
}

record find_name_class_request {
    string name
    int class_id
}

record find_result {
    object object
}

record object_request {
    object object
}

rpc entity(object_request) -> entity_transform
rpc find_name(find_name_request) -> find_result
rpc find_name_class(find_name_class_request) -> find_result
rpc object(object_request) -> object_info
