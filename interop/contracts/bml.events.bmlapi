{
  "api": "bml.events",
  "version": { "major": 1, "minor": 0 },
  "schemas": [
    {
      "id": 1,
      "name": "event",
      "fields": [
        { "id": 1, "name": "kind", "type": "int" },
        { "id": 2, "name": "filename", "type": "string", "optional": true },
        { "id": 3, "name": "is_map", "type": "bool", "optional": true },
        { "id": 4, "name": "master_name", "type": "string", "optional": true },
        { "id": 5, "name": "filter_class", "type": "int", "optional": true },
        { "id": 6, "name": "add_to_scene", "type": "bool", "optional": true },
        { "id": 7, "name": "reuse_meshes", "type": "bool", "optional": true },
        { "id": 8, "name": "reuse_materials", "type": "bool", "optional": true },
        { "id": 9, "name": "dynamic", "type": "bool", "optional": true },
        { "id": 10, "name": "object_ids", "type": "array<object>", "optional": true },
        { "id": 11, "name": "master_object", "type": "object", "optional": true },
        { "id": 12, "name": "script", "type": "object", "optional": true },
        { "id": 13, "name": "target", "type": "object", "optional": true },
        { "id": 14, "name": "fixed", "type": "bool", "optional": true },
        { "id": 15, "name": "friction", "type": "float", "optional": true },
        { "id": 16, "name": "elasticity", "type": "float", "optional": true },
        { "id": 17, "name": "mass", "type": "float", "optional": true },
        { "id": 18, "name": "collision_group", "type": "string", "optional": true },
        { "id": 19, "name": "start_frozen", "type": "bool", "optional": true },
        { "id": 20, "name": "enable_collision", "type": "bool", "optional": true },
        { "id": 21, "name": "auto_calculate_mass_center", "type": "bool", "optional": true },
        { "id": 22, "name": "linear_damp", "type": "float", "optional": true },
        { "id": 23, "name": "rot_damp", "type": "float", "optional": true },
        { "id": 24, "name": "collision_surface", "type": "string", "optional": true },
        { "id": 25, "name": "mass_center", "type": "vec3", "optional": true },
        { "id": 26, "name": "convex_meshes", "type": "array<object>", "optional": true },
        { "id": 27, "name": "ball_centers", "type": "array<vec3>", "optional": true },
        { "id": 28, "name": "ball_radii", "type": "array<float>", "optional": true },
        { "id": 29, "name": "concave_meshes", "type": "array<object>", "optional": true },
        { "id": 30, "name": "command", "type": "string", "optional": true },
        { "id": 31, "name": "command_args", "type": "array<string>", "optional": true },
        { "id": 32, "name": "config_category", "type": "string", "optional": true },
        { "id": 33, "name": "config_key", "type": "string", "optional": true },
        { "id": 34, "name": "config_type", "type": "int", "optional": true },
        { "id": 35, "name": "config_value", "type": "string", "optional": true },
        { "id": 36, "name": "cheat_enabled", "type": "bool", "optional": true }
      ]
    }
  ],
  "endpoints": [
    { "name": "all", "kind": "stream", "output": 1 }
  ]
}
