include_guard(GLOBAL)

set(BML_RUNTIME sdl CACHE STRING "Engine runtime")
set_property(CACHE BML_RUNTIME PROPERTY STRINGS sdl virtools)
if(BML_RUNTIME STREQUAL "sdl")
    set(BML_RUNTIME_SDL 1)
    if(VIRTOOLS_SDK_PATH OR VIRTOOLS_SDK_INCLUDE_DIR)
        message(FATAL_ERROR "Use CK2/VxMath packages and a clean SDL build directory")
    endif()
elseif(BML_RUNTIME STREQUAL "virtools")
    if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4 OR NOT MSVC
            OR NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "X86")
        message(FATAL_ERROR "Virtools requires a Windows x86 MSVC ABI build (VS 2022: -A Win32)")
    endif()
    set(BML_RUNTIME_SDL 0)
else()
    message(FATAL_ERROR "BML_RUNTIME must be sdl or virtools")
endif()
add_compile_definitions(BML_RUNTIME_SDL=${BML_RUNTIME_SDL})
if(BML_HOST_LINKAGE STREQUAL "static")
    message(FATAL_ERROR "Use BML_HOST_LINKAGE=dynamic for the ${BML_RUNTIME} runtime")
endif()

macro(bml_find_engine)
    if(BML_RUNTIME_SDL)
        if(NOT TARGET SDL3::SDL3)
            find_package(SDL3 3.4.8 CONFIG REQUIRED)
        endif()
        if(NOT TARGET VxMath AND NOT TARGET VxMath::VxMath)
            find_package(VxMath CONFIG REQUIRED)
        endif()
        if(NOT TARGET VxMath AND TARGET VxMath::VxMath)
            add_library(VxMath ALIAS VxMath::VxMath)
        endif()
        if(NOT TARGET CK2)
            find_package(CK2 CONFIG REQUIRED)
        endif()
    else()
        find_package(VirtoolsSDK MODULE REQUIRED)
        add_library(CK2 ALIAS VirtoolsSDK::CK2)
        add_library(VxMath ALIAS VirtoolsSDK::VxMath)
    endif()
    # Imported interface targets keep the installed BML package independent
    # of whether this build also installs the engine's development package.
    foreach(_engine CK2 VxMath)
        if(NOT TARGET BML::${_engine})
            add_library(BML::${_engine} INTERFACE IMPORTED)
            set_property(TARGET BML::${_engine} PROPERTY INTERFACE_LINK_LIBRARIES ${_engine})
        endif()
    endforeach()
endmacro()

function(bml_verify_script_package root)
    set(metadata "${root}/share/CKAngelScript/CKAngelScript.runtime.json")
    if(NOT EXISTS "${metadata}")
        message(FATAL_ERROR "CKANGELSCRIPT_ROOT must contain the matching CKAngelScript SDK and runtime package")
    endif()
    file(READ "${metadata}" package)
    set(fields schema runtime platform architecture host_linkage)
    set(expected 1 "${BML_RUNTIME}" "${BML_TARGET_PLATFORM}" "${BML_TARGET_ARCH}" "${BML_HOST_LINKAGE}")
    foreach(field value IN ZIP_LISTS fields expected)
        string(JSON actual ERROR_VARIABLE parse_error GET "${package}" "${field}")
        if(parse_error OR NOT actual STREQUAL value)
            message(FATAL_ERROR "CKAngelScript package ${field} must be ${value}: ${metadata}")
        endif()
    endforeach()
endfunction()
