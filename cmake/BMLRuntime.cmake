include_guard(GLOBAL)

if(WIN32)
    set(_bml_default_runtime win32)
else()
    set(_bml_default_runtime sdl)
endif()
set(BML_RUNTIME "${_bml_default_runtime}" CACHE STRING "Engine runtime: win32 or sdl")
set_property(CACHE BML_RUNTIME PROPERTY STRINGS win32 sdl)
if(NOT BML_RUNTIME MATCHES "^(win32|sdl)$")
    message(FATAL_ERROR "BML_RUNTIME must be win32 or sdl")
endif()
if(DEFINED BML_CONFIGURED_RUNTIME AND NOT BML_CONFIGURED_RUNTIME STREQUAL BML_RUNTIME)
    message(FATAL_ERROR "Use a separate build directory for each BML_RUNTIME")
endif()
set(BML_CONFIGURED_RUNTIME "${BML_RUNTIME}" CACHE INTERNAL "Configured engine ABI")
if(BML_RUNTIME STREQUAL "win32")
    if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
        message(FATAL_ERROR "The win32 runtime requires Windows x86; use BML_RUNTIME=sdl for other targets")
    endif()
    set(BML_RUNTIME_SDL 0)
else()
    # The SDL engine integration has been withdrawn pending design review.
    # Do not build a loader with missing hooks or fall back to win32 internals.
    message(FATAL_ERROR
        "The BML sdl runtime is temporarily unavailable: its engine integration "
        "has been withdrawn pending design review. The win32 backend is unchanged.")
    set(BML_RUNTIME_SDL 1)
    if(VIRTOOLS_SDK_PATH OR VIRTOOLS_SDK_INCLUDE_DIR)
        message(FATAL_ERROR "Ballanced cannot use the win32 Virtools SDK. Use a clean build directory without VIRTOOLS_SDK_PATH")
    endif()
endif()
add_compile_definitions(BML_RUNTIME_SDL=${BML_RUNTIME_SDL})

set(BALLANCED_ROOT "${PROJECT_SOURCE_DIR}/../Ballanced" CACHE PATH "Ballanced source tree (or empty to use installed CK2/VxMath packages)")

macro(bml_find_engine)
    if(BML_RUNTIME STREQUAL "win32")
        find_package(VirtoolsSDK REQUIRED)
    else()
        find_package(SDL3 3.4.8 CONFIG REQUIRED)
        if(NOT TARGET VxMath AND EXISTS "${BALLANCED_ROOT}/Source/VxMath/CMakeLists.txt")
            set(VXMATH_INSTALL ON CACHE BOOL "" FORCE)
            set(VXMATH_BUILD_SHARED ON CACHE BOOL "" FORCE)
            set(VXMATH_BUILD_STATIC OFF CACHE BOOL "" FORCE)
            add_subdirectory("${BALLANCED_ROOT}/Source/VxMath" "engine/VxMath")
        elseif(NOT TARGET VxMath)
            find_package(VxMath CONFIG REQUIRED)
        endif()
        if(NOT TARGET CK2 AND EXISTS "${BALLANCED_ROOT}/Source/CK2/CMakeLists.txt")
            set(CK2_INSTALL ON CACHE BOOL "" FORCE)
            set(CK2_BUILD_SHARED ON CACHE BOOL "" FORCE)
            set(CK2_BUILD_STATIC OFF CACHE BOOL "" FORCE)
            add_subdirectory("${BALLANCED_ROOT}/Source/CK2" "engine/CK2")
        elseif(NOT TARGET CK2)
            find_package(CK2 CONFIG REQUIRED)
        endif()
        foreach(_engine CK2 VxMath)
            if(NOT TARGET VirtoolsSDK::${_engine})
                add_library(VirtoolsSDK::${_engine} INTERFACE IMPORTED)
                set_property(TARGET VirtoolsSDK::${_engine} PROPERTY INTERFACE_LINK_LIBRARIES ${_engine})
            endif()
        endforeach()
    endif()
endmacro()
