@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(_BML_SAVED_CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}")
set(CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR};${CMAKE_MODULE_PATH}")
set(BML_RUNTIME "@BML_RUNTIME@")
set(BML_HOST_LINKAGE "@BML_HOST_LINKAGE@")
set(BML_TARGET_PLATFORM "@BML_TARGET_PLATFORM@")
set(BML_TARGET_ARCH "@BML_TARGET_ARCH@")
set(BML_SDK_ABI_ID "@BML_SDK_ABI_ID@")
set(BML_SDK_CK2_ABI_ID "@BML_SDK_CK2_ABI_ID@")
set(BML_SDK_VXMATH_ABI_ID "@BML_SDK_VXMATH_ABI_ID@")
set(BML_SDK_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(BML_SDK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(BML_SDK_POINTER_SIZE "@CMAKE_SIZEOF_VOID_P@")
set(BML_SDK_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@")
set(BML_ABI_JSON [==[@BML_ABI_JSON@]==])
set(BML_ENGINE_ABI_ID "@BML_ENGINE_ABI_ID@")
set(BML_IMGUI_ABI_ID "@BML_IMGUI_ABI_ID@")
set(BML_INSTALLED_SDK TRUE)
# Imported extension targets may be named without making ordinary C Mods load
# or validate C++ engine packages. Dependencies are resolved before generation
# only when the final link graph actually uses an extension.
foreach(_engine CK2 VxMath)
    if(NOT TARGET BML::${_engine})
        add_library(BML::${_engine} INTERFACE IMPORTED)
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/BMLTargets.cmake")
set(CMAKE_MODULE_PATH "${_BML_SAVED_CMAKE_MODULE_PATH}")
unset(_BML_SAVED_CMAKE_MODULE_PATH)

# Only the optional C++ extensions share a runtime with their host. The core C
# protocol pairs allocation and release inside each module's own runtime.
set(BML_MSVC_RUNTIME_LIBRARY "")
get_target_property(_bml_imported_configurations BML::BML IMPORTED_CONFIGURATIONS)
if (_bml_imported_configurations)
    set(_bml_has_debug FALSE)
    set(_bml_has_release FALSE)
    foreach (_bml_imported_configuration IN LISTS _bml_imported_configurations)
        if (_bml_imported_configuration STREQUAL "DEBUG")
            set(_bml_has_debug TRUE)
        else ()
            set(_bml_has_release TRUE)
        endif ()
    endforeach ()
    if (_bml_has_debug AND NOT _bml_has_release)
        set(BML_MSVC_RUNTIME_LIBRARY "MultiThreadedDebugDLL")
    elseif (_bml_has_release AND NOT _bml_has_debug)
        set(BML_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
    endif ()
    unset(_bml_imported_configuration)
    unset(_bml_has_debug)
    unset(_bml_has_release)
endif ()
unset(_bml_imported_configurations)

include("${CMAKE_CURRENT_LIST_DIR}/BMLMod.cmake")
foreach(_var BML_SDK_COMPILER_ID BML_SDK_COMPILER_VERSION BML_SDK_POINTER_SIZE BML_SDK_SYSTEM_NAME
        BML_SDK_CK2_ABI_ID BML_SDK_VXMATH_ABI_ID BML_MSVC_RUNTIME_LIBRARY)
    set_property(TARGET BML::BML PROPERTY "${_var}" "${${_var}}")
endforeach()
cmake_language(DEFER CALL _bml_resolve_sdk_extensions)

set_and_check(BML_INTERFACE_CODEGEN
              "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/BML/tools/interface_codegen.py")
include("${CMAKE_CURRENT_LIST_DIR}/BMLInterface.cmake")

set_and_check(BML_IMC_CODEGEN
              "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/BML/tools/imc_codegen.py")
include("${CMAKE_CURRENT_LIST_DIR}/BMLImc.cmake")
