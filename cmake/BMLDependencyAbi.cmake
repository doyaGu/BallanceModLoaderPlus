include_guard(GLOBAL)

# Follow the public umbrella header through the include paths of the selected
# target. Source and installed targets use the same content-based identity;
# unrelated source checkouts and absolute installation paths never enter it.
function(bml_dependency_abi target umbrella output)
    set(_targets "${target}")
    set(_visited_targets "")
    set(_directories "")
    set(_settings "")
    while(_targets)
        list(POP_FRONT _targets _target)
        if(_target IN_LIST _visited_targets OR NOT TARGET "${_target}")
            continue()
        endif()
        list(APPEND _visited_targets "${_target}")
        foreach(_property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_COMPILE_DEFINITIONS
                          INTERFACE_COMPILE_OPTIONS INTERFACE_LINK_LIBRARIES)
            get_target_property(_values "${_target}" "${_property}")
            if(NOT _values)
                continue()
            endif()
            foreach(_value IN LISTS _values)
                if(_value MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                    set(_value "${CMAKE_MATCH_1}")
                elseif(_value MATCHES "^\\$<(INSTALL_INTERFACE|LINK_ONLY):")
                    continue()
                endif()
                if(_property STREQUAL "INTERFACE_INCLUDE_DIRECTORIES")
                    if(_value MATCHES "\\$<")
                        message(FATAL_ERROR "Cannot fingerprint ${target} include path: ${_value}")
                    endif()
                    file(REAL_PATH "${_value}" _directory)
                    list(APPEND _directories "${_directory}")
                elseif(_property STREQUAL "INTERFACE_LINK_LIBRARIES")
                    if(TARGET "${_value}")
                        list(APPEND _targets "${_value}")
                    endif()
                else()
                    list(APPEND _settings "${_property}:${_value}")
                endif()
            endforeach()
        endforeach()
    endwhile()
    list(REMOVE_DUPLICATES _directories)
    set(_entry "")
    foreach(_directory IN LISTS _directories)
        if(EXISTS "${_directory}/${umbrella}")
            set(_entry "${_directory}/${umbrella}")
            break()
        endif()
    endforeach()
    if(NOT _entry)
        message(FATAL_ERROR "Cannot fingerprint ${target}: ${umbrella} not found in its public include paths")
    endif()
    set(_queue "${_entry}")
    set(_visited "")
    set(_records "")
    while(_queue)
        list(POP_FRONT _queue _header)
        file(REAL_PATH "${_header}" _header)
        if(_header IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited "${_header}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_header}")
        foreach(_directory IN LISTS _directories)
            file(RELATIVE_PATH _name "${_directory}" "${_header}")
            if(NOT _name MATCHES "^\\.\\./" AND NOT IS_ABSOLUTE "${_name}")
                break()
            endif()
        endforeach()
        file(SHA256 "${_header}" _hash)
        list(APPEND _records "${_name}:${_hash}")
        get_filename_component(_parent "${_header}" DIRECTORY)
        file(STRINGS "${_header}" _includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
        foreach(_include IN LISTS _includes)
            if(_include MATCHES "^[ \t]*#[ \t]*include[ \t]*([<\"])([^>\"]+)[>\"]")
                set(_name "${CMAKE_MATCH_2}")
                set(_search ${_directories})
                if(CMAKE_MATCH_1 STREQUAL "\"")
                    list(PREPEND _search "${_parent}")
                endif()
                foreach(_directory IN LISTS _search)
                    if(EXISTS "${_directory}/${_name}")
                        list(APPEND _queue "${_directory}/${_name}")
                        break()
                    endif()
                endforeach()
            endif()
        endforeach()
    endwhile()
    list(REMOVE_DUPLICATES _records)
    list(SORT _records)
    list(REMOVE_DUPLICATES _settings)
    list(SORT _settings)
    string(SHA256 _abi "bml-dependency-1;${_records};${_settings}")
    set("${output}" "${_abi}" PARENT_SCOPE)
endfunction()
