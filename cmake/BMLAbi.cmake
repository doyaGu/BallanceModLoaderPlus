include_guard(GLOBAL)

set(BML_HOST_LINKAGE dynamic CACHE STRING "Host linkage: dynamic or static")
set_property(CACHE BML_HOST_LINKAGE PROPERTY STRINGS dynamic static)
if(NOT BML_HOST_LINKAGE MATCHES "^(dynamic|static)$")
    message(FATAL_ERROR "BML_HOST_LINKAGE must be dynamic or static")
endif()
if(WIN32)
    set(BML_TARGET_PLATFORM windows)
elseif(APPLE)
    set(BML_TARGET_PLATFORM macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(BML_TARGET_PLATFORM linux)
else()
    message(FATAL_ERROR "Unsupported BML target: ${CMAKE_SYSTEM_NAME}")
endif()
set(_bml_arch "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES _bml_arch_count)
    if(NOT _bml_arch_count EQUAL 1)
        message(FATAL_ERROR "Build a separate BML SDK for each architecture")
    endif()
    set(_bml_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(CMAKE_GENERATOR_PLATFORM)
    set(_bml_arch "${CMAKE_GENERATOR_PLATFORM}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_bml_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
string(TOLOWER "${_bml_arch}" _bml_arch)
if(_bml_arch MATCHES "^(aarch64|arm64)$")
    set(BML_TARGET_ARCH arm64)
elseif(CMAKE_SIZEOF_VOID_P EQUAL 4 AND _bml_arch MATCHES "^(x86|win32|i[3-6]86|amd64|x86_64)$")
    set(BML_TARGET_ARCH x86)
elseif(_bml_arch MATCHES "^(x64|amd64|x86_64)$")
    set(BML_TARGET_ARCH x64)
else()
    message(FATAL_ERROR "Unsupported BML architecture: ${_bml_arch}")
endif()

# Exact header content identifies the SDK, including uncommitted engine APIs.
# No path or timestamp enters the ID, so installed SDKs stay relocatable.
file(GLOB_RECURSE _bml_abi_headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/include/BML/*.h" "${PROJECT_SOURCE_DIR}/include/BML/*.hpp")
list(APPEND _bml_abi_headers "${PROJECT_SOURCE_DIR}/deps/imgui/imgui.h" "${PROJECT_SOURCE_DIR}/src/BMLImGuiConfig.h")
include("${CMAKE_CURRENT_LIST_DIR}/BMLDependencyAbi.cmake")
bml_dependency_abi(CK2 CKAll.h BML_SDK_CK2_ABI_ID)
bml_dependency_abi(VxMath VxMath.h BML_SDK_VXMATH_ABI_ID)
set(_bml_abi_input "bml-native-2;${BML_RUNTIME};${BML_TARGET_PLATFORM};${BML_TARGET_ARCH};${BML_HOST_LINKAGE};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_CXX_FLAGS};${BML_SDK_CK2_ABI_ID};${BML_SDK_VXMATH_ABI_ID}")
list(SORT _bml_abi_headers)
foreach(_header IN LISTS _bml_abi_headers)
    file(SHA256 "${_header}" _hash)
    string(APPEND _bml_abi_input ";${_hash}")
endforeach()
string(SHA256 BML_SDK_ABI_ID "${_bml_abi_input}")
string(SHA256 BML_ENGINE_ABI_ID "bml-engine-1;${BML_SDK_CK2_ABI_ID};${BML_SDK_VXMATH_ABI_ID};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_CXX_FLAGS}")
file(SHA256 "${PROJECT_SOURCE_DIR}/deps/imgui/imgui.h" _bml_imgui_header)
file(SHA256 "${PROJECT_SOURCE_DIR}/src/BMLImGuiConfig.h" _bml_imgui_config)
string(SHA256 BML_IMGUI_ABI_ID "bml-imgui-1;${_bml_imgui_header};${_bml_imgui_config};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_CXX_FLAGS}")
# The SDK fingerprint is diagnostic. Only opted-in C++ extensions require their
# exact dependency/compiler/configuration ABI; ordinary C tables do not.
set(BML_ABI_JSON "{\"schema\":2,\"mod_api\":\"bml.mod\",\"mod_api_major\":1,\"runtime\":\"${BML_RUNTIME}\",\"platform\":\"${BML_TARGET_PLATFORM}\",\"architecture\":\"${BML_TARGET_ARCH}\",\"host_linkage\":\"${BML_HOST_LINKAGE}\",\"sdk_abi\":\"${BML_SDK_ABI_ID}\",\"configuration\":\"$<CONFIG>\",\"extension_abis\":{\"engine\":\"${BML_ENGINE_ABI_ID}-$<CONFIG>\",\"imgui\":\"${BML_IMGUI_ABI_ID}-$<CONFIG>\"}}")
set(BML_ABI_INCLUDE_DIR "${PROJECT_BINARY_DIR}/generated/include")
configure_file("${PROJECT_SOURCE_DIR}/cmake/Abi.h.in" "${BML_ABI_INCLUDE_DIR}/BML/Abi.h" @ONLY)
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/abi/$<CONFIG>/BML.abi.json" CONTENT "${BML_ABI_JSON}\n")

# The same values are used by in-tree Mods and installed SDK consumers.
set(BML_SDK_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}")
set(BML_SDK_COMPILER_VERSION "${CMAKE_CXX_COMPILER_VERSION}")
set(BML_SDK_POINTER_SIZE "${CMAKE_SIZEOF_VOID_P}")
set(BML_SDK_SYSTEM_NAME "${CMAKE_SYSTEM_NAME}")
